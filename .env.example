POSTGRES_DB=airflow

# --- Airflow Admin & Security ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Generate a real key via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho=

# --- Kafka Configuration ---
KAFKA_CLUSTER_ID=btc-kraft-cluster-v1
KAFKA_TOPIC=prod.binance.btc_usdt_1s.v1
# Kafka producer needs a bootstrap URL (unused in local compose but referenced)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- Spark Resources ---
SPARK_WORKER_MEMORY=4G
SPARK_WORKER_CORES=2 --- PostgreSQL (Airflow Metadata DB) ---
